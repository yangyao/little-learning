{
  "metadata": {
    "name": "Warm Tactile Wood",
    "version": "1.0.0",
    "dimensionUnit": "pt",
    "durationUnit": "s",
    "referenceSyntax": "References use a dotted token path enclosed in braces.",
    "scope": "iPhone-first children learning games; light appearance",
    "source": "stitch-source/code.html + screen.png; normalized in SOURCE_REVIEW.md",
    "status": "Implementation baseline; not user-tested"
  },
  "primitive": {
    "color": {
      "linen": "#F8F4EC",
      "board": "#F7F2EA",
      "tray": "#FBF8F1",
      "birch": "#E8DCB8",
      "beech": "#8C5835",
      "beechDark": "#643A1B",
      "teak": "#C87A3E",
      "teakDark": "#9C5824",
      "moss": "#4A7C59",
      "mossDark": "#355940",
      "ochre": "#E6AA38",
      "ochreDark": "#B37F1E",
      "walnut": "#3E2723",
      "deepInk": "#2B1C18",
      "slate": "#7A6658",
      "recess": "#D8CEBA",
      "border": "#DFD4BD",
      "traySide": "#C9BFA8",
      "secondary": "#ECE4D0",
      "successBg": "#E6F0E9",
      "hintBg": "#FCF6EA",
      "disabledFill": "#D4C8B0",
      "disabledStroke": "#A6977F",
      "white": "#FFFFFF"
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "controlGap": 12,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "xxl": 40,
      "xxxl": 48
    },
    "radius": {
      "small": 12,
      "medium": 16,
      "large": 24
    }
  },
  "semantic": {
    "color": {
      "canvas": "{primitive.color.board}",
      "surface": "{primitive.color.linen}",
      "tray": "{primitive.color.tray}",
      "textPrimary": "{primitive.color.walnut}",
      "textSecondary": "{primitive.color.slate}",
      "actionPrimary": "{primitive.color.beech}",
      "actionPrimarySide": "{primitive.color.beechDark}",
      "onPrimary": "{primitive.color.white}",
      "object": "{primitive.color.teak}",
      "objectSide": "{primitive.color.teakDark}",
      "onObject": "{primitive.color.deepInk}",
      "success": "{primitive.color.moss}",
      "successSide": "{primitive.color.mossDark}",
      "onSuccess": "{primitive.color.white}",
      "successText": "{primitive.color.mossDark}",
      "successBackground": "{primitive.color.successBg}",
      "hint": "{primitive.color.ochre}",
      "hintSide": "{primitive.color.ochreDark}",
      "hintText": "{primitive.color.beechDark}",
      "onHint": "{primitive.color.beechDark}",
      "hintBackground": "{primitive.color.hintBg}",
      "recess": "{primitive.color.recess}",
      "slotStroke": "{primitive.color.beechDark}",
      "borderDecorative": "{primitive.color.border}",
      "traySide": "{primitive.color.traySide}",
      "secondaryFill": "{primitive.color.secondary}",
      "disabledFill": "{primitive.color.disabledFill}",
      "disabledStroke": "{primitive.color.disabledStroke}",
      "disabledInk": "{primitive.color.slate}"
    },
    "spacing": {
      "xs": "{primitive.spacing.xs}",
      "sm": "{primitive.spacing.sm}",
      "controlGap": "{primitive.spacing.controlGap}",
      "md": "{primitive.spacing.md}",
      "lg": "{primitive.spacing.lg}",
      "xl": "{primitive.spacing.xl}",
      "xxl": "{primitive.spacing.xxl}",
      "xxxl": "{primitive.spacing.xxxl}"
    },
    "radius": {
      "small": "{primitive.radius.small}",
      "control": "{primitive.radius.medium}",
      "tray": "{primitive.radius.large}"
    },
    "size": {
      "touchMinimum": 64,
      "audio": 64,
      "token": 72,
      "phoneMargin": 20,
      "tabletMargin": 32
    },
    "stroke": {
      "hairline": 1,
      "highlightTop": 1.5,
      "control": 2
    },
    "typography": {
      "display": {
        "size": 32,
        "lineHeight": 40,
        "weight": 700,
        "textStyle": "largeTitle",
        "swiftWeight": "bold",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      },
      "title": {
        "size": 28,
        "lineHeight": 36,
        "weight": 700,
        "textStyle": "title",
        "swiftWeight": "bold",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      },
      "heading": {
        "size": 22,
        "lineHeight": 30,
        "weight": 800,
        "textStyle": "title2",
        "swiftWeight": "heavy",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      },
      "body": {
        "size": 20,
        "lineHeight": 28,
        "weight": 500,
        "textStyle": "title3",
        "swiftWeight": "medium",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      },
      "label": {
        "size": 20,
        "lineHeight": 26,
        "weight": 600,
        "textStyle": "title3",
        "swiftWeight": "semibold",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      },
      "support": {
        "size": 17,
        "lineHeight": 24,
        "weight": 500,
        "textStyle": "body",
        "swiftWeight": "medium",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      },
      "caption": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400,
        "textStyle": "footnote",
        "swiftWeight": "regular",
        "family": "system rounded with platform CJK fallback",
        "dynamicType": true
      }
    },
    "motion": {
      "restDepth": 4,
      "pressedDepth": 1,
      "dragDepth": 6,
      "trayDepth": 6,
      "pressTravel": 3,
      "dragScale": 1.08,
      "dragRotation": 0,
      "pressDuration": 0.1,
      "liftDuration": 0.16,
      "returnDuration": 0.24,
      "successDuration": 0.35,
      "completionDuration": 0.6,
      "springResponse": 0.35,
      "springDamping": 0.65,
      "reduceMotionFadeDuration": 0.15,
      "successTravel": 4,
      "snapRadius": 36,
      "gestureTolerance": 12
    },
    "material": {
      "highlightTopAlpha": 0.45,
      "highlightLeftAlpha": 0.3,
      "lightDirection": "top-left",
      "texture": "none by default; low contrast optional"
    },
    "shadow": {
      "raised": {
        "color": "{primitive.color.walnut}",
        "x": 0,
        "y": 8,
        "cssBlur": 16,
        "swiftUIRadius": 8.0,
        "alpha": 0.18,
        "inset": false,
        "mapping": "Approximation; verify on device"
      },
      "pressed": {
        "color": "{primitive.color.walnut}",
        "x": 0,
        "y": 2,
        "cssBlur": 4,
        "swiftUIRadius": 2.0,
        "alpha": 0.12,
        "inset": false,
        "mapping": "Approximation; verify on device"
      },
      "dragged": {
        "color": "{primitive.color.walnut}",
        "x": 0,
        "y": 12,
        "cssBlur": 28,
        "swiftUIRadius": 14.0,
        "alpha": 0.25,
        "inset": false,
        "mapping": "Approximation; verify on device"
      },
      "tray": {
        "color": "{primitive.color.walnut}",
        "x": 0,
        "y": 12,
        "cssBlur": 24,
        "swiftUIRadius": 12.0,
        "alpha": 0.08,
        "inset": false,
        "mapping": "Approximation; verify on device"
      },
      "slot": {
        "color": "{primitive.color.walnut}",
        "x": 0,
        "y": 3,
        "cssBlur": 6,
        "swiftUIRadius": 3.0,
        "alpha": 0.22,
        "inset": true,
        "mapping": "Approximation; verify on device"
      },
      "secondary": {
        "color": "{primitive.color.walnut}",
        "x": 0,
        "y": 2,
        "cssBlur": 3,
        "swiftUIRadius": 1.5,
        "alpha": 0.08,
        "inset": true,
        "mapping": "Approximation; verify on device"
      }
    }
  },
  "component": {
    "primaryButton": {
      "fill": "{semantic.color.actionPrimary}",
      "ink": "{semantic.color.onPrimary}",
      "radius": "{semantic.radius.control}",
      "minimumHitSize": "{semantic.size.touchMinimum}"
    },
    "secondaryButton": {
      "fill": "{semantic.color.secondaryFill}",
      "ink": "{semantic.color.textPrimary}",
      "radius": "{semantic.radius.control}",
      "minimumHitSize": "{semantic.size.touchMinimum}"
    },
    "audioButton": {
      "fill": "{semantic.color.hint}",
      "ink": "{semantic.color.onHint}",
      "radius": "{semantic.radius.control}",
      "minimumHitSize": "{semantic.size.touchMinimum}",
      "shape": "circle",
      "diameter": "{semantic.size.audio}"
    },
    "learningToken": {
      "fill": "{semantic.color.object}",
      "ink": "{semantic.color.onObject}",
      "radius": "{semantic.radius.control}",
      "minimumHitSize": "{semantic.size.touchMinimum}",
      "size": "{semantic.size.token}",
      "dragScale": "{semantic.motion.dragScale}"
    },
    "dropSlot": {
      "fill": "{semantic.color.recess}",
      "ink": "{semantic.color.textSecondary}",
      "radius": "{semantic.radius.control}",
      "minimumHitSize": "{semantic.size.touchMinimum}"
    },
    "questionTray": {
      "fill": "{semantic.color.tray}",
      "ink": "{semantic.color.textPrimary}",
      "radius": "{semantic.radius.tray}",
      "minimumHitSize": "{semantic.size.touchMinimum}"
    },
    "gameCard": {
      "fill": "{semantic.color.surface}",
      "ink": "{semantic.color.textPrimary}",
      "radius": "{semantic.radius.tray}",
      "minimumHitSize": "{semantic.size.touchMinimum}"
    }
  },
  "theme": {
    "math": {
      "accent": "{primitive.color.moss}",
      "accentInk": "{primitive.color.white}",
      "usage": "Decorative subject accent only; never overrides feedback or primary controls"
    },
    "chinese": {
      "accent": "{primitive.color.teak}",
      "accentInk": "{primitive.color.deepInk}",
      "usage": "Decorative subject accent only; never overrides feedback or primary controls"
    },
    "english": {
      "accent": "{primitive.color.ochre}",
      "accentInk": "{primitive.color.deepInk}",
      "usage": "Decorative subject accent only; never overrides feedback or primary controls"
    },
    "art": {
      "accent": "{primitive.color.birch}",
      "accentInk": "{primitive.color.deepInk}",
      "usage": "Decorative subject accent only; never overrides feedback or primary controls"
    }
  },
  "contrastPairs": [
    {
      "name": "primary label",
      "foreground": "{semantic.color.onPrimary}",
      "background": "{semantic.color.actionPrimary}",
      "minimum": 4.5
    },
    {
      "name": "token numeral",
      "foreground": "{semantic.color.onObject}",
      "background": "{semantic.color.object}",
      "minimum": 4.5
    },
    {
      "name": "audio symbol",
      "foreground": "{semantic.color.onHint}",
      "background": "{semantic.color.hint}",
      "minimum": 3
    },
    {
      "name": "secondary body",
      "foreground": "{semantic.color.textSecondary}",
      "background": "{semantic.color.surface}",
      "minimum": 4.5
    },
    {
      "name": "hint body",
      "foreground": "{semantic.color.hintText}",
      "background": "{semantic.color.hintBackground}",
      "minimum": 4.5
    },
    {
      "name": "success body",
      "foreground": "{semantic.color.successText}",
      "background": "{semantic.color.successBackground}",
      "minimum": 4.5
    },
    {
      "name": "success symbol",
      "foreground": "{semantic.color.onSuccess}",
      "background": "{semantic.color.success}",
      "minimum": 3
    },
    {
      "name": "slot outline",
      "foreground": "{semantic.color.slotStroke}",
      "background": "{semantic.color.recess}",
      "minimum": 3
    }
  ]
}
